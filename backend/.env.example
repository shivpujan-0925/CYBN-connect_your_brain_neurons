# Server
PORT=5000
NODE_ENV=development
# Comma-separate multiple origins in production, e.g.:
# CLIENT_ORIGIN=https://cybn.app,https://www.cybn.app
CLIENT_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=cybn_token

# MongoDB (Atlas free tier works great — see DEPLOY.md for setup)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database-name>
# MONGODB_URI=mongodb+srv://your_user:your_password@your-cluster.mongodb.net/cybn

# Cloudinary (https://cloudinary.com — free tier is enough)
# Leave blank to fall back to the default anonymous avatar instead of real uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
